{
  "name": "xiaole-comment-collector",
  "version": "1.0.2",
  "private": true,
  "description": "自动滚动采集抖音主评论，按点赞或回复排序，一键导出 CSV。",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
