    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.321",
    "esbuild": "^0.25.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.11.1",
    "playwright": "1.64.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1"
  }
}
