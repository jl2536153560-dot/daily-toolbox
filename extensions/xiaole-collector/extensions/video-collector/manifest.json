{
  "manifest_version": 3,
  "name": "小乐收集 · 视频采集",
  "version": "1.0.3",
  "description": "采集抖音与B站视频、主页作品和达人资料；连接自己的飞书表格与百炼，导出内容并生成逐字稿。",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "storage",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "小乐收集 · 爆款视频抓取逐字稿",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://douyin.com/*"
      ],
      "js": [
        "douyin-profile-cache.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://douyin.com/*"
      ],
      "js": [
        "douyin-profile-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://douhot.douyin.com/*",
        "https://www.douyin.com/*",
        "https://douyin.com/*",
        "https://www.iesdouyin.com/*",
        "https://iesdouyin.com/*",
        "https://www.douyin.com/user/*",
        "https://douyin.com/user/*",
        "https://www.douyin.com/video/*",
        "https://douyin.com/video/*",
        "https://www.douyin.com/note/*",
        "https://douyin.com/note/*"
      ],
      "js": [
        "douhot-extractor.user.js",
        "chat-monitor.js"
      ],
      "run_at": "document_idle",
      "css": [
        "xiaole-content.css"
      ]
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://message.bilibili.com/*"
      ],
      "js": [
        "bilibili-core.js",
        "bilibili-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "xiaole-content.css"
      ]
    }
  ],
  "host_permissions": [
    "https://douhot.douyin.com/*",
    "https://v.douyin.com/*",
    "https://www.iesdouyin.com/*",
    "https://iesdouyin.com/*",
    "https://www.douyin.com/*",
    "https://douyin.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://*.aliyuncs.com/*",
    "https://open.feishu.cn/*",
    "https://base-api.feishu.cn/*",
    "https://aweme.snssdk.com/*",
    "https://*.douyinvod.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.bytecdn.com/*",
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.bilivideo.net/*"
  ]
}
